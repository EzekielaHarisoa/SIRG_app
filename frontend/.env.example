[TEMPLATE]
# Base URL of the SIRG Spring Boot backend API.
#
# Leave this empty during development: `npm run dev` proxies the API prefixes
# (/api, /employe, /pointage, /soldeConge, /demandeConge) to
# http://localhost:8080, which keeps browser calls same-origin (the backend
# sends no CORS headers). See vite.config.js.
#
# Set it only for a deployed build that is served from another origin than the
# API, e.g.:
# VITE_API_BASE_URL=http://localhost:8080
